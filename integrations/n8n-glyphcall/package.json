{
	"name": "n8n-nodes-glyphcall",
	"version": "0.2.0",
	"description": "n8n node that turns Word, Excel, PowerPoint and PDF files into text or fields as JSON, and creates, validates and reads XRechnung, ZUGFeRD and Factur-X e-invoices.",
	"license": "MIT",
	"homepage": "https://glyphcall.com",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"pdf",
		"pdf-to-text",
		"docx",
		"word",
		"excel",
		"xlsx",
		"powerpoint",
		"markdown",
		"invoice",
		"e-invoice",
		"xrechnung",
		"zugferd",
		"factur-x",
		"en16931",
		"document-extraction",
		"ocr-alternative",
		"attachments"
	],
	"author": {
		"name": "SpellzCode",
		"email": "spellz111122@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Nutshell2000/agent-data-tools.git",
		"directory": "integrations/n8n-glyphcall"
	},
	"bugs": {
		"url": "https://github.com/Nutshell2000/agent-data-tools/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/description.test.cjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/GlyphcallApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Glyphcall/Glyphcall.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.56.2",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
