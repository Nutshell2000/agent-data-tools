{
  "source": "https://glyphcall.com/openapi.json",
  "note": "The three document tools and the three e-invoice tools, copied from the service catalog (src/routes/document.ts, src/routes/pdf.ts, src/routes/einvoice.ts) on 14 Nov 2026.",
  "tools": {
    "/document/extract": {
      "price": "$0.03",
      "params": {
        "url": {
          "required": true,
          "type": "string"
        },
        "fields": {
          "required": true,
          "type": "string"
        }
      }
    },
    "/document/text": {
      "price": "$0.005",
      "params": {
        "url": {
          "required": true,
          "type": "string"
        },
        "format": {
          "required": false,
          "type": "string",
          "enum": [
            "markdown",
            "text"
          ]
        },
        "maxChars": {
          "required": false,
          "type": "integer"
        }
      }
    },
    "/pdf/text": {
      "price": "$0.005",
      "params": {
        "url": {
          "required": true,
          "type": "string"
        },
        "firstPage": {
          "required": false,
          "type": "integer"
        },
        "pages": {
          "required": false,
          "type": "integer"
        },
        "maxChars": {
          "required": false,
          "type": "integer"
        }
      }
    },
    "/einvoice/create": {
      "price": "$0.01",
      "params": {
        "invoice": {
          "required": true,
          "type": "string"
        },
        "format": {
          "required": false,
          "type": "string",
          "enum": [
            "xrechnung",
            "xrechnung-ubl",
            "zugferd",
            "ubl"
          ]
        }
      }
    },
    "/einvoice/validate": {
      "price": "$0.01",
      "params": {
        "url": {
          "required": false,
          "type": "string"
        },
        "xml": {
          "required": false,
          "type": "string"
        },
        "profile": {
          "required": false,
          "type": "string",
          "enum": [
            "auto",
            "xrechnung",
            "en16931"
          ]
        }
      }
    },
    "/einvoice/to-json": {
      "price": "$0.01",
      "params": {
        "url": {
          "required": false,
          "type": "string"
        },
        "xml": {
          "required": false,
          "type": "string"
        }
      }
    }
  }
}
