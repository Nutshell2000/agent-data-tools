{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Quote front cut-over (19 Nov 2026, owner: "Yes, cut over"): this full app runs as "agent-data-tools-core". The
  // name "agent-data-tools", its workers.dev address, every custom domain below and every production secret belong
  // to the small front Worker (wrangler.front.jsonc, src/front/index.ts), which answers repeated unpaid quotes and
  // passes everything else here over a service binding. Deploy this file with the guard (it names the core); deploy
  // the front with `npx wrangler deploy -c wrangler.front.jsonc` only when src/front changes.
  "name": "agent-data-tools-core",
  "main": "src/index.ts",
  "build": { "command": "npm run build:reader" },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Reached only through the front: no public address of its own, no routes (they stay attached to the front).
  // The routes the front serves: glyphcall.com, www/api/mcp/lex/tts/web.glyphcall.com and tools.funwords.eu.
  "workers_dev": false,
  // Workers forbid runtime code generation, so Ajv's compiler can never succeed here; this stand-in
  // fails at once instead of spending ~300 ms of CPU per cold start (see src/lib/ajv-unavailable.ts).
  "alias": { "ajv/dist/2020.js": "./src/lib/ajv-unavailable.ts" },
  // Stored logs are sampled at 1% (14 Nov 2026). At 100% every request stored about 19 log events (one invocation line,
  // plus 701 library warnings on each cold start): about 238 million a month against the 20 million the plan includes,
  // billed per extra million. `wrangler tail` is live and is not affected by this setting.
  "observability": { "enabled": true, "head_sampling_rate": 0.01 },
  // Workers AI and Browser Rendering run on the account's free daily allowance.
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" },
  // Cloudflare Email Service: sends the one message a free-key sign-up gets (lib/free-keys.ts). Sending is enabled on
  // tools.funwords.eu (14 Nov 2026, `wrangler email sending enable`); the sender is FREE_KEY_FROM below.
  "send_email": [{ "name": "EMAIL" }],
  // Store downloads. run_worker_first keeps them behind the paid-order check.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  // Trial counters are opt-in via TRIALS_ENABLED=on; this KV binding also holds store orders.
  "kv_namespaces": [{ "binding": "TRIALS", "id": "aa10fdf7e8f143dc876b89b91726bab5" }],
  // EU law search index (routes/law-search.ts, 14 Nov 2026): passages + FTS5 in D1 (EU jurisdiction), bge-m3 vectors in
  // Vectorize (1,024 dims, cosine, metadata indexes on short and kind). Built by scripts/law-index/build.mjs.
  "d1_databases": [{ "binding": "LAW_DB", "database_name": "eu-law-v2", "database_id": "9e240b67-4933-452d-adb9-18d5015da4c6" }],
  "vectorize": [{ "binding": "LAW_VECTORS", "index_name": "eu-law-v2" }, { "binding": "SE_VECTORS", "index_name": "se-law" }],
  // Request counters per paid path (see src/metrics.ts).
  // The Worker cannot fetch its own workers.dev URL, so /x402/check reaches this service through itself.
  // FRONT_SECRETS: the production secrets live with the front's name; src/lib/front-secrets.ts reads them once per isolate.
  "services": [{ "binding": "SELF", "service": "agent-data-tools-core" }, { "binding": "FRONT_SECRETS", "service": "agent-data-tools", "entrypoint": "Secrets" }],
  "durable_objects": { "bindings": [{ "name": "METRICS", "class_name": "Metrics" }] },
  // The ledger, counters and replay state moved here from the single Worker "agent-data-tools" at the cut-over
  // (rehearsed 19 Nov there and back with every row). Never add new_sqlite_classes for Metrics again.
  "migrations": [{ "tag": "v1", "transferred_classes": [{ "from": "Metrics", "from_script": "agent-data-tools", "to": "Metrics" }] }],
  // Cookieless measurement (src/lib/beacon.ts): page beacons (/e), MCP client names and AI-crawler reads are written to
  // Workers Analytics Engine, one non-blocking data point each: no Durable Object or KV write per request. Cloudflare
  // creates the dataset at the first write after a deploy with this binding; read it with the SQL API
  // (node scripts/analytics-queries.mjs prints the queries).
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "glyphcall_events" }],
  "vars": {
    // Free keys by e-mail, 100 calls a month (owner, 14 Nov 2026: "Yes, 100 a month"; "Yes, use funwords.eu now").
    // Anything but "on" switches the offer and its links off. Move the sender when the product domain has mail.
    "FREE_KEYS": "on",
    "FREE_KEY_FROM": "keys@tools.funwords.eu",
    // Free voice keys without e-mail (lib/voice-keys.ts, 16 Nov 2026). Anything but "on" switches a route off (404) and
    // stops its keys at once. Worst case per UTC day if every limit is reached, from the model prices in that file:
    // test keys about $3.50 (never above $6: 2,000 counted calls of at most $0.003), trial keys about $0.15.
    // OFF in production until both are proven on staging (wrangler.staging.jsonc has them on): set to "on" to offer them.
    "VOICE_TEST_KEYS": "on",
    "VOICE_TEST_KEYS_PER_DAY": "100",
    "CREDITS_TRIAL": "on",
    "CREDITS_TRIAL_MINUTES": "60",
    // Address that receives every payment (USDC on Base).
    "PAY_TO": "0x6293ded2684f1a76e26becef87c137d691fbf800",
    // eip155:8453 = Base mainnet, eip155:84532 = Base Sepolia testnet.
    "NETWORK": "eip155:8453",
    // Also accept USDC on Polygon and Arbitrum (same PAY_TO, same CDP facilitator). Monad (eip155:143) and World Chain (eip155:480)
    // were dropped on 22 Oct 2026: nothing was ever paid to us there, and Dexter's verifier (the free route to a Bazaar listing)
    // refused every route while they were quoted; the sellers it pays quote Base, Polygon, Arbitrum and Solana only.
    "EXTRA_NETWORKS": "eip155:137,eip155:42161",
    // Solana USDC receiver (the owner's Phantom wallet). x402 SPL transfers do not create the recipient's account; its
    // USDC associated token account C7L5qhPw7xMs6qf8jEyZQiwmoB9oDZ24cFvRaedbECwR exists since 22 Oct 2026 (checked
    // against the derived address). Dexter's verifier pays on Solana; empty switches Solana off.
    "SOLANA_PAY_TO": "82wfSCZhCmZA7zwqqt6Q3FG8nqYBwUvbThP6M97fa9Q6",
    // Tempo address that receives per-call MPP payments in USDC.e (src/lib/mpp-tempo.ts): PAY_TO, the desk's income
    // wallet (owner's decision of 2026-11-08; until then her Coinbase Wallet 0x2074…77f5, option A of 2026-10-20 in
    // docs/mpp-per-call.md). A plain key, so it can send on Tempo too. Empty switches the tempo method off.
    "TEMPO_PAY_TO": "0x6293ded2684f1a76e26becef87c137d691fbf800",
    // Per-call MPP with USDC on Base to PAY_TO (src/lib/mpp-evm.ts) is ON unless this is "off": it reuses the x402
    // facilitator and the CDP secret, so it needs nothing new. MPPScan lists the tools from it (docs/mpp-per-call.md).
    "MPP_EVM": "on",
    // The public home of the human pages: glyphcall.com since 15 Nov 2026 (owner: "fix it all"). Pages for people on a
    // retired host answer 301 to the same path here (src/lib/public-site.ts movedPageUrl). Never list the workers.dev
    // origin as retired: it is the paid origin every listing and wallet history points at.
    "PUBLIC_SITE_ORIGIN": "https://glyphcall.com",
    // www.glyphcall.com is listed too (15 Nov 2026): its pages answer 301 to the apex, the one canonical home.
    "RETIRED_PUBLIC_HOSTS": "tools.funwords.eu,www.glyphcall.com",
    // The paid origin keeps every API, MCP, payment, /credits and tool path; only a browser's GET (Accept: text/html)
    // of a human page there answers 301 to the same path on glyphcall.com (16 Nov 2026, movedBrowserPageUrl).
    "BROWSER_PAGES_MOVED_HOSTS": "agent-data-tools.revmesh2074.workers.dev",
    // The name on the pages for people (src/lib/public-brand.ts); agent surfaces keep the service name.
    "PUBLIC_BRAND": "Glyphcall",
    // Keyless facilitator. For the Coinbase Bazaar set this to
    // https://api.cdp.coinbase.com/platform/v2/x402 and add the secrets
    // CDP_API_KEY_ID / CDP_API_KEY_SECRET with `wrangler secret put`.
    "FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
    // "off" disables the paywall (local testing only).
    "PAYWALL": "on",
    // Free calls (src/lib/free-calls.ts): 25 per caller, automatic over MCP, trial=1 over HTTP.
    // Without the exact value "on", every unpaid call receives the normal payment challenge.
    "TRIALS_ENABLED": "on",
    // The capped free PDF try for browsers (src/lib/pdf-try.ts): 2 pages a read, 3 a visitor, 150 a day in total.
    // The owner, 14 Nov 2026: "Yes, switch it on". Remove the line to make PDF reading paid only again.
    "PDF_TRY": "on",
    // Only a private endpoint here changes anything: public ones keep their measured order (src/lib/rpc.ts EDGE_RPCS).
    "BASE_RPC_URL": "https://mainnet.base.org",
    // /search: at most this many Brave Search API requests per UTC day (src/routes/search.ts). Brave bills $5 per 1,000
    // from prepaid credits and gives free credits each month; 120 a day (about $18 a month) stays inside them, and
    // the tool answers 503, uncharged, above the cap or when the credits are gone. The key is the secret SEARCH_API_KEY.
    // Raised to 1,000 on 27 Oct 2026 (owner: "fix it all"): web search is the biggest paid category on the Bazaar
    // (StableEnrich exa/search: 161 payers, 30k calls/30 days) and 120 a day would turn away a repeat buyer on day one.
    // Every search-backed tool is paid (CAPACITY_LIMITED: no free calls), so each call nets about $0.004 after Brave.
    "SEARCH_DAILY_CAP": "1000",
    // Spend caps that matter on Workers Paid, where Workers AI and Browser Rendering are billed per use (on the free plan
    // the platform's own daily allowances stop them first). Workers AI calls per UTC day: 1,000 of the 8B chat model cost
    // about $0.30-1.00 and earn $10 at $0.01 a call. Hosted-browser launches per UTC day: 60 short sessions stay inside the
    // 10 browser-hours a month the paid plan includes. Over a cap the tool answers 503, uncharged (src/lib/daily-cap.ts).
    "AI_DAILY_CAP": "1000",
    "BROWSER_DAILY_CAP": "200",
    // Stripe profile (@spellzz) for MPP card payments of credit packs; the key is the secret STRIPE_MPP_KEY.
    "STRIPE_PROFILE_ID": "profile_61VXy8TZgWPaLVrUgA6VXy8TRdQCmC1PKY56LWKJkVfM"
  }
}
