{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-data-tools",
  "main": "src/index.ts",
  "build": { "command": "npm run build:reader" },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers forbid runtime code generation, so Ajv's compiler can never succeed here; this stand-in
  // fails at once instead of spending ~300 ms of CPU per cold start (see src/lib/ajv-unavailable.ts).
  "alias": { "ajv/dist/2020.js": "./src/lib/ajv-unavailable.ts" },
  "observability": { "enabled": true },
  // Workers AI and Browser Rendering run on the account's free daily allowance.
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" },
  // Store downloads. run_worker_first keeps them behind the paid-order check.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  // Trial counters are opt-in via TRIALS_ENABLED=on; this KV binding also holds store orders.
  "kv_namespaces": [{ "binding": "TRIALS", "id": "aa10fdf7e8f143dc876b89b91726bab5" }],
  // Request counters per paid path (see src/metrics.ts).
  // The Worker cannot fetch its own workers.dev URL, so /x402/check reaches this service through itself.
  "services": [{ "binding": "SELF", "service": "agent-data-tools" }],
  "durable_objects": { "bindings": [{ "name": "METRICS", "class_name": "Metrics" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Metrics"] }],
  "vars": {
    // Address that receives every payment (USDC on Base).
    "PAY_TO": "0x2074c40346ae2a90e0e4a391bcee6f16bf5277f5",
    // eip155:8453 = Base mainnet, eip155:84532 = Base Sepolia testnet.
    "NETWORK": "eip155:8453",
    // Also accept USDC on Polygon and Arbitrum (same PAY_TO, same CDP facilitator). Monad (eip155:143) and World Chain (eip155:480)
    // were dropped on 22 Oct 2026: nothing was ever paid to us there, and Dexter's verifier (the free route to a Bazaar listing)
    // refused every route while they were quoted; the sellers it pays quote Base, Polygon, Arbitrum and Solana only.
    "EXTRA_NETWORKS": "eip155:137,eip155:42161",
    // Solana USDC receiver (Peter's Phantom wallet). x402 SPL transfers do not create the recipient's account; its
    // USDC associated token account C7L5qhPw7xMs6qf8jEyZQiwmoB9oDZ24cFvRaedbECwR exists since 22 Oct 2026 (checked
    // against the derived address). Dexter's verifier pays on Solana; empty switches Solana off.
    "SOLANA_PAY_TO": "82wfSCZhCmZA7zwqqt6Q3FG8nqYBwUvbThP6M97fa9Q6",
    // Tempo address that receives per-call MPP payments in USDC.e (src/lib/mpp-tempo.ts): PAY_TO, by Peter's
    // decision of 2026-10-20 (option A in docs/mpp-per-call.md; his wallet shows the address on Tempo Mainnet and can
    // send from it). Empty switches the tempo method off.
    "TEMPO_PAY_TO": "0x2074c40346ae2a90e0e4a391bcee6f16bf5277f5",
    // Per-call MPP with USDC on Base to PAY_TO (src/lib/mpp-evm.ts) is ON unless this is "off": it reuses the x402
    // facilitator and the CDP secret, so it needs nothing new. MPPScan lists the tools from it (docs/mpp-per-call.md).
    "MPP_EVM": "on",
    // Keyless facilitator. For the Coinbase Bazaar set this to
    // https://api.cdp.coinbase.com/platform/v2/x402 and add the secrets
    // CDP_API_KEY_ID / CDP_API_KEY_SECRET with `wrangler secret put`.
    "FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
    // "off" disables the paywall (local testing only).
    "PAYWALL": "on",
    // Free calls (src/lib/free-calls.ts): 25 per caller, automatic over MCP, trial=1 over HTTP.
    // Without the exact value "on", every unpaid call receives the normal payment challenge.
    "TRIALS_ENABLED": "on",
    // Only a private endpoint here changes anything: public ones keep their measured order (src/lib/rpc.ts EDGE_RPCS).
    "BASE_RPC_URL": "https://mainnet.base.org",
    // /search: at most this many Brave Search API requests per UTC day (src/routes/search.ts). Brave bills $5 per 1,000
    // from prepaid credits and gives free credits each month; 120 a day (about $18 a month) stays inside them, and
    // the tool answers 503, uncharged, above the cap or when the credits are gone. The key is the secret SEARCH_API_KEY.
    "SEARCH_DAILY_CAP": "120",
    // Spend caps that matter on Workers Paid, where Workers AI and Browser Rendering are billed per use (on the free plan
    // the platform's own daily allowances stop them first). Workers AI calls per UTC day: 1,000 of the 8B chat model cost
    // about $0.30-1.00 and earn $10 at $0.01 a call. Hosted-browser launches per UTC day: 60 short sessions stay inside the
    // 10 browser-hours a month the paid plan includes. Over a cap the tool answers 503, uncharged (src/lib/daily-cap.ts).
    "AI_DAILY_CAP": "1000",
    "BROWSER_DAILY_CAP": "60",
    // Stripe profile (@spellzz) for MPP card payments of credit packs; the key is the secret STRIPE_MPP_KEY.
    "STRIPE_PROFILE_ID": "profile_61VXy8TZgWPaLVrUgA6VXy8TRdQCmC1PKY56LWKJkVfM"
  }
}
